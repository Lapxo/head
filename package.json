{
  "name": "@lapxo/head",
  "version": "0.2.0",
  "type": "module",
  "description": "An MCP server that folds: it runs bound as a process, hands a model what bound printed, and lands what it read as receipts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lapxo/head.git"
  },
  "author": "Lapxo",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "head": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "TARGET.bound",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p . --incremental false --tsBuildInfoFile null",
    "prepack": "npm run build && node --test test/pack.test.ts",
    "test": "node --test test/*.test.ts && node --test --test-concurrency=1 test/time/*.test.ts"
  },
  "dependencies": {
    "@lapxo/bound": "0.2.8",
    "@lapxo/topos": "0.2.4",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
