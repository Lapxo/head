{
 "openapi": "3.1.0",
 "info": {
  "title": "accounts",
  "version": "1"
 },
 "servers": [
  {
   "url": "https://accounts.example"
  }
 ],
 "paths": {
  "/login": {
   "post": {
    "operationId": "login",
    "tags": [
     "accounts"
    ],
    "security": [],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "email": {
          "type": "string",
          "format": "email"
         },
         "password": {
          "type": "string",
          "format": "password"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "a token",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "token": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/select-shop": {
   "post": {
    "operationId": "selectShop",
    "tags": [
     "accounts"
    ],
    "security": [],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "shopId": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "a token for one shop"
     }
    }
   }
  }
 }
}
