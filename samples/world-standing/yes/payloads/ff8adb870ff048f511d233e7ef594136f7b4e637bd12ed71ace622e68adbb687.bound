bound-lock/1 about="name: release\non:\n  pull_request:\n  push:\n    branches: [main]\n  workflow_dispatch:\n    inputs:\n      publish:\n        description: Publish the existing draft only after owner approval\n        type: boolean\n        default: false\npermissions:\n  contents: read\nconcurrency:\n  group: release-${{ github.ref }}\n  cancel-in-progress: false\njobs:\n  verify:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        node: [22, 24]\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n      - run: npm ci --ignore-scripts\n      - run: npm run build\n      - run: node --test test/prior-place.test.ts test/compile-region.test.ts\n      - name: Verify admitted producer obligations\n        env:\n          INSTRUMENT: ${{ runner.temp }}/topos-openapi-bound\n        run: |\n          npm install --prefix \"$INSTRUMENT\" --no-save --ignore-scripts --no-audit --no-fund @lapxo/bound@0.2.8\n          node \"$INSTRUMENT/node_modules/@lapxo/bound/dist/cli/verb.js\" fold --check\n      - name: Verify the exact delivery\n        run: |\n          set -euo pipefail\n          node --input-type=module <<'NODE'\n          import { readFileSync } from 'node:fs';\n          import { strict as assert } from 'node:assert';\n          import { createHash } from 'node:crypto';\n          import { toposStanding } from '@lapxo/topos/standing';\n          const manifest = JSON.parse(readFileSync('delivery/release.json'));\n          assert.equal(manifest.version, JSON.parse(readFileSync('package.json')).version);\n          assert.match(manifest.capsule, /^sha256:[0-9a-f]{64}$/);\n          assert.match(manifest.standing, /^sha256:[0-9a-f]{64}$/);\n          const hash = bytes => 'sha256:' + createHash('sha256').update(bytes).digest('hex');\n          assert.equal(hash(readFileSync('delivery/' + manifest.capsule.slice(7) + '.tar.gz')), manifest.capsule);\n          assert.equal(hash(readFileSync('delivery/standing.bound')), manifest.standing);\n          assert.equal(toposStanding(readFileSync('TARGET.bound', 'utf8').trim().split('\\n')), readFileSync('delivery/standing.bound', 'utf8'));\n          NODE\n  publish:\n    needs: verify\n    if: github.event_name == 'workflow_dispatch' && inputs.publish && github.ref == 'refs/heads/main'\n    environment: release\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n      - run: npm install --prefix .instrument --no-save --ignore-scripts --no-audit --no-fund @lapxo/bound@0.2.8\n      - name: Publish only the owner-approved existing assets\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          tag=\"v$(node -p \"require('./package.json').version\")\"\n          digest=\"$(node -e \"const m=require('./delivery/release.json'); if(!/^sha256:[0-9a-f]{64}$/.test(m.capsule))process.exit(1); console.log(m.capsule)\")\"\n          archive=\"${digest#sha256:}.tar.gz\"\n          standing=\"$(node -e \"const m=require('./delivery/release.json'); if(!/^sha256:[0-9a-f]{64}$/.test(m.standing))process.exit(1); console.log(m.standing)\")\"\n          test \"$(git rev-parse HEAD)\" = \"$(git rev-list -n 1 \"$tag\")\"\n          test \"$(gh release view \"$tag\" --json isDraft --jq .isDraft)\" = true\n          stage=\"$(mktemp -d \"$RUNNER_TEMP/topos-openapi-release.XXXXXX\")\"\n          trap 'rm -rf \"$stage\"' EXIT\n          gh release download \"$tag\" --pattern approval-signed --dir \"$stage\"\n          node .instrument/node_modules/@lapxo/bound/dist/cli/verb.js fold --as release \"$stage/approval-signed\" > \"$stage/verdict\"\n          read -r status approved artifact source extra < \"$stage/verdict\"\n          test \"$status\" = READY\n          test -z \"$extra\"\n          test \"$approved\" = \"$digest\"\n          test \"$artifact\" = \"$archive\"\n          test \"$source\" = \"https://github.com/$GITHUB_REPOSITORY/releases/download/$tag/$archive\"\n          for asset in \"$archive\" standing.bound release.json; do\n            gh release download \"$tag\" --pattern \"$asset\" --dir \"$stage\"\n            cmp \"delivery/$asset\" \"$stage/$asset\"\n          done\n          printf '%s  %s\\n' \"${digest#sha256:}\" \"$stage/$archive\" | sha256sum -c -\n          printf '%s  %s\\n' \"${standing#sha256:}\" \"$stage/standing.bound\" | sha256sum -c -\n          gh release edit \"$tag\" --draft=false\n" at=policy:openapi/native-document-compatibility/0.1.2 form=alphabet measure=text role=writes scope=prose/en/documents/pipeline-release value=lock
